# Local hackathon demo. Leave Luminal blank to run deterministic policies without AI.
TRUSTLAYER_DB_PATH=./trustlayer.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set all three from your actual Luminal dashboard/documentation.
# LUMINAL_API_KEY=replace_me
# LUMINAL_API_BASE_URL=https://YOUR_PROVIDER_BASE_URL/v1
# LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Live retail discovery. Demo is the default until you explicitly enable eBay.
# Use PRODUCTION keys for actual eBay listings. Never commit secrets.
PRODUCT_SEARCH_PROVIDER=demo
# EBAY_CLIENT_ID=your_production_app_id
# EBAY_CLIENT_SECRET=your_production_cert_id

# Serper Google Shopping - alternative to eBay; works with a self-service key.
# Set PRODUCT_SEARCH_PROVIDER=serper in your PRIVATE backend/.env, then restart.
# SERPER_API_KEY=your_rotated_private_key
