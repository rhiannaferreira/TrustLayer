# Local hackathon demo. Leave Luminal blank to run deterministic policies without AI.
TRUSTLAYER_DB_PATH=./trustlayer.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://trust-layer-henna.vercel.app
# Optional: also allow Vercel preview URLs of the frontend.
# CORS_ORIGIN_REGEX=https://trust-layer-.*\.vercel\.app

# Set all three from your actual Luminal dashboard/documentation.
# LUMINAL_API_KEY=replace_me
# LUMINAL_API_BASE_URL=https://YOUR_PROVIDER_BASE_URL/v1
# LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Product discovery for POST /api/v1/agent/run and /api/v1/products/search.
# demo (default) = fictional, labeled demo catalog. ebay = eBay Buy Browse API (authorized, no scraping).
# PRODUCT_SEARCH_PROVIDER=ebay
# EBAY_CLIENT_ID=replace_me
# EBAY_CLIENT_SECRET=replace_me
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_ENVIRONMENT=production   # or sandbox
# If the live provider fails, use the labeled demo catalog instead of returning 503 (default false).
# PRODUCT_SEARCH_DEMO_FALLBACK=false
# Provider listings older than this need review before purchase (seconds, default 3600).
# PRODUCT_LISTING_MAX_AGE_SECONDS=3600
