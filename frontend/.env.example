# Where Live Backend Mode sends requests.
# Leave empty (recommended for local dev) to use the Vite dev/preview proxy below — no CORS needed.
# Or set the full backend URL, e.g. http://127.0.0.1:8000 (the backend must then allow CORS).
VITE_API_BASE_URL=
# Target for the Vite proxy (/health, /openapi.json, /api/*).
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# true  = start in Demo Mode (deterministic in-browser engine, no backend needed)
# false = start in Live Backend Mode (errors are shown, never replaced with mock results)
VITE_USE_MOCKS=true
